{
  "id": "WeiboHot",
  "meta": {
    "name": "微博热搜",
    "version": "1.0",
    "author": "LiteMonitor",
    "description": "实时显示微博热搜榜第一条，桌面吃瓜神器"
  },
  "inputs": [],
  "execution": {
    "type": "chain",
    "interval": 300,
    "steps": [
      {
        "id": "fetch_wb",
        "url": "https://weibo.com/ajax/side/hotSearch",
        "method": "GET",
        "headers": {
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
          "Referer": "https://weibo.com/",
          "Accept": "application/json, text/plain, */*"
        },
        "response_format": "json",
        "extract": {
          "top_word": "data.realtime[0].word",
          "top_label": "data.realtime[0].label_name"
        },
        "process": [
          {
            "var": "icon_map",
            "source": "top_label",
            "function": "map",
            "map": {
              "爆": "🔥",
              "热": "🔴",
              "新": "🆕",
              "荐": "👍",
              "沸": "🔥"
            }
          },
          {
            "var": "final_icon",
            "source": "icon_map",
            "function": "regex_replace",
            "pattern": "^$",
            "to": "🍉"
          }
        ]
      }
    ]
  },
  "outputs": [
    {
      "key": "hot",
      "label": "微博热搜",
      "short_label": "WB",
      "format_val": "{{final_icon}} {{top_word}}",
      "link": "https://s.weibo.com/weibo?q={{top_word}}",
      "color": "1"
    }
  ]
}